      "--font-display",
      "--ink",
      "--ink-40",
      "--ink-60",
      "--leading-body",
      "--leading-heading",
      "--leading-tight",
      "--mist",
      "--mist-deep",
      "--petrol",
      "--petrol-08",
      "--petrol-12",
      "--petrol-deep",
      "--petrol-soft",
      "--radius-droplet",
